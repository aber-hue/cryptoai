DATABASE_URL="mysql://username:password@host:3306/main_db?charset=utf8mb4"
FEATURE_DATABASE_URL="mysql://username:password@host:3306/feature_db?charset=utf8mb4"
OAUTH_SERVER_URL="http://host:8233/api"
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
AUTH_TOKEN_TTL_SECONDS="604800"
BUILT_IN_OPENAI_API_URL="http://your-openai-gateway:9222/v1/responses"
BUILT_IN_OPENAI_API_KEY="your-openai-compatible-key"
BUILT_IN_OPENAI_MODEL="gpt-5.5"

# Optional: route Free Chat to an external agent API instead of the local tool loop.
FREE_CHAT_AGENT_API_URL="http://your-agent-host:9224/v1/responses"
FREE_CHAT_AGENT_API_KEY="your-agent-key"
FREE_CHAT_AGENT_MODEL="cryptoaiiask"
BIGQUERY_PROJECT_ID="your-project-id"
BIGQUERY_DATASET="your_dataset"
BIGQUERY_CREDENTIALS_PATH="./secrets/bigquery-service-account.json"
CMC_API_KEY="your-cmc-api-key"
